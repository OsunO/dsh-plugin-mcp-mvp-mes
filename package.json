{
  "name": "dsh-plugin-mcp-mvp-mes",
  "version": "0.2.6",
  "description": "通过 MOM MES 的 MCP 服务，把工单、订单、检验单等查询工具提供给智能体。API Key 在本插件页面上配置，保存在 Harness 凭据库中；保存后连接自动重建，无需重启。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "mes",
    "mom",
    "streamable-http"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OsunO/dsh-plugin-mcp-mvp-mes.git"
  },
  "homepage": "https://www.npmjs.com/package/dsh-plugin-mcp-mvp-mes",
  "bugs": {
    "url": "https://github.com/OsunO/dsh-plugin-mcp-mvp-mes/issues"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "files": [
    "lib/index.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
